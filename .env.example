# Shared logging
LOG_LEVEL=info

# API
API_PORT=4000
API_ORIGIN=http://localhost:3000
SESSION_SECRET=change-me-in-real-envs
INTERNAL_SECRET=change-me-too-in-real-envs
# Secrets must be set (and differ from these placeholders) when NODE_ENV=production.
# SESSION_SECRET and INTERNAL_SECRET are shared by api and realtime.

# Realtime
REALTIME_PORT=4001
API_INTERNAL_URL=http://localhost:4000

# Worker
WORKER_PORT=4002

# Admin console (token must be 32+ characters in production)
ADMIN_PORT=4003
ADMIN_TOKEN=dev-only-admin-token

# Experimental feature flags (JSON): shop, creatorStudio, aiNpc, sponsoredZones. The basic weekly Campus Wars scoring is active; the campusWars flag is reserved for future expanded event features.
FEATURE_FLAGS={}

# Web (public, safe for client bundle)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4001

# Persistence (adapters land in Phase 2; local dev uses the in-memory store)
DATABASE_URL=postgres://campus:campus@localhost:5432/campus
REDIS_URL=redis://localhost:6379

# Durable API snapshot directory (players, ledger, inventory, rooms). Use a persistent disk. Unset = memory-only dev mode.
DATA_DIR=./.data
# Comma-separated terms rejected in names and bios (3+ letters each).
BLOCKED_TERMS=
ANALYTICS=console   # optional: print anonymous analytics events as JSON logs
NEXT_PUBLIC_DEBUG_PANEL=0   # 1 shows the diagnostics panel (backtick key) in production builds

# Phase 5 (social + moderation)
# API -> realtime: pushes block changes so blocked pairs disappear from each other's world immediately.
REALTIME_INTERNAL_URL=http://localhost:4001
# Admin console uses API_INTERNAL_URL + INTERNAL_SECRET (above) to read and resolve reports.
